{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(git push * v*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags*)",
      "Bash(glab release *)",
      "Bash(glab api *tags*)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node C:/Users/PC/.claude/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "oh-my-claudecode@omc": true
  },
  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    }
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
